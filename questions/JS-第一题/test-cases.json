[
  {
    "id": "example-1",
    "description": "题目示例 1：存在两个不同的三元组",
    "input": { "nums": [-1, 0, 1, 2, -1, -4] },
    "expectedOutput": [[-1, -1, 2], [-1, 0, 1]]
  },
  {
    "id": "example-2",
    "description": "题目示例 2：没有符合条件的三元组",
    "input": { "nums": [0, 1, 1] },
    "expectedOutput": []
  },
  {
    "id": "example-3",
    "description": "题目示例 3：三个零",
    "input": { "nums": [0, 0, 0] },
    "expectedOutput": [[0, 0, 0]]
  },
  {
    "id": "extra-1",
    "description": "多个零只能返回一个三元组",
    "input": { "nums": [0, 0, 0, 0, 0] },
    "expectedOutput": [[0, 0, 0]]
  },
  {
    "id": "extra-2",
    "description": "全部为正数",
    "input": { "nums": [1, 2, 3, 4] },
    "expectedOutput": []
  },
  {
    "id": "extra-3",
    "description": "全部为负数",
    "input": { "nums": [-4, -3, -2, -1] },
    "expectedOutput": []
  },
  {
    "id": "extra-4",
    "description": "恰好三个元素且存在答案",
    "input": { "nums": [1, -1, 0] },
    "expectedOutput": [[-1, 0, 1]]
  },
  {
    "id": "extra-5",
    "description": "重复元素可以使用，但对应下标必须不同",
    "input": { "nums": [-2, 0, 0, 2, 2] },
    "expectedOutput": [[-2, 0, 2]]
  },
  {
    "id": "extra-6",
    "description": "两个相同数值来自不同元素，结果需要去重",
    "input": { "nums": [-1, -1, 2, 2] },
    "expectedOutput": [[-1, -1, 2]]
  },
  {
    "id": "extra-7",
    "description": "多个答案，包含两个相同数值组成的三元组",
    "input": { "nums": [-2, -1, -1, 0, 1, 1, 2] },
    "expectedOutput": [[-2, 0, 2], [-2, 1, 1], [-1, -1, 2], [-1, 0, 1]]
  }
]
